{
	"name": "proyecto",
	"version": "1.0.0",
	"description": "",
	"main": "dist/app.js",
	"scripts": {
		"dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only --ignore-watch node_modules --no-notify src/app.ts",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"start": "node dist/app.js",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --fix",
		"typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/infrastructure/persistence/dataSource/DataSource.ts",
		"migration:generate": "npm run typeorm migration:generate ./src/infrastructure/persistence/migrations/migration",
		"migration:run": "npm run typeorm migration:run",
		"migration:revert": "npm run typeorm migration:revert",
		"seed": "ts-node -r tsconfig-paths/register src/infrastructure/persistence/seed/Seed.ts",
		"test": "jest",
		"test:ci": "jest --coverage --maxWorkers=2",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test-contract": "mocha --node-option \"import=tsx\" --require tsconfig-paths/register src/Test/Contract/Tests/**/*.spec.ts",
		"prepare": "husky"
	},
	"lint-staged": {
		"src/**/*.{ts,js}": [
			"eslint --fix"
		]
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.73.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
		"@opentelemetry/instrumentation-typeorm": "^0.15.0",
		"@opentelemetry/resources": "^2.7.0",
		"@opentelemetry/sdk-node": "^0.215.0",
		"@opentelemetry/semantic-conventions": "^1.40.0",
		"@pact-foundation/pact": "^13.2.0",
		"amqplib": "^0.10.9",
		"axios": "^1.13.2",
		"class-transformer": "^0.5.1",
		"consul": "^2.0.1",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.10.1",
		"pg": "^8.16.3",
		"pino": "^10.3.1",
		"reflect-metadata": "^0.2.2",
		"tsyringe": "^4.10.0",
		"uuid": "^13.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@types/amqplib": "^0.10.8",
		"@types/chai": "^5.2.3",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/mocha": "^10.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^24.12.2",
		"@types/supertest": "^6.0.3",
		"chai": "^6.2.1",
		"eslint": "^9.39.4",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"jest": "^30.2.0",
		"lint-staged": "^16.3.3",
		"mocha": "^11.7.5",
		"nodemon": "^3.1.14",
		"supertest": "^7.1.4",
		"ts-jest": "^29.4.6",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"tsc-alias": "^1.8.16",
		"tsc-watch": "^7.2.0",
		"tsconfig-paths": "^4.2.0",
		"typeorm": "^0.3.27",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.50.1"
	}
}
